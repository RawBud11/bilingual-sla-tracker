// Return the text for `key` in `lang` ("en" or "es"), with {placeholders} filled.
// Unknown languages fall back to English; a missing key shows the key itself
// so the gap is visible instead of crashing a daily run.
function t(lang, key, vars) {
  var table = STRINGS[lang] || STRINGS.en;
  var text = key in table ? table[key] : key;
  return text.replace(/\{(\w+)\}/g, function (whole, name) {
    return vars && name in vars ? String(vars[name]) : whole;
  });
}

// Singular or plural form: tCount("en", "digest.intro", 3) uses "digest.intro_other".
function tCount(lang, key, count, vars) {
  var all = Object.assign({ count: count }, vars || {});
  return t(lang, key + (count === 1 ? "_one" : "_other"), all);
}

// Lowercase, no accents, single spaces: "Categoría " and "categoria" match.
function foldText(text) {
  return String(text == null ? "" : text)
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .replace(/\s+/g, " ")
    .trim();
}

// Find the id behind a cell value: "Tarjeta perdida o robada", "card lost or
// stolen" and "card_lost_stolen" all give "card_lost_stolen". Returns "" when
// nothing matches.
function idFromLabel(kind, value, ids) {
  var folded = foldText(value);
  if (!folded) return "";
  for (var i = 0; i < ids.length; i++) {
    var id = ids[i];
    if (folded === id || folded === foldText(STRINGS.en[kind + "." + id]) ||
        folded === foldText(STRINGS.es[kind + "." + id])) {
      return id;
    }
  }
  return "";
}

// ===== src/summary.js =====
// Weekly summary tab: one row per category and per language, plus a total.
//
// What each column counts:
// - Opened: tickets created in the 7 days up to "now".
// - First response met / missed: of those opened tickets, how many got their
//   first response inside / outside the SLA target.
// - Open now: tickets not resolved yet, whenever they were created.
// - Stale follow-ups: "Waiting on customer" for over 2 business days, now.
// Subjects are never part of the summary, only counts.

function summaryCounts(tickets, startMin, nowMin) {
  var counts = { opened: 0, met: 0, missed: 0, open_now: 0, stale: 0 };
  tickets.forEach(function (tk) {
    var created = toMinutes(tk.createdAt);
    if (created !== null && created >= startMin && created <= nowMin) {
      counts.opened++;
      if (tk.sla === "met") counts.met++;
      if (tk.sla === "missed") counts.missed++;
    }
    if (tk.status !== "resolved") counts.open_now++;
    if (tk.stale) counts.stale++;
  });
  return counts;
}

// Returns a 2D array: title row, header row, then one row per group.
function weeklySummary(tickets, now, lang) {
  var nowMin = toMinutes(now);
  var startMin = nowMin - SUMMARY_DAYS * 1440;
  var real = tickets.filter(function (tk) { return !tk.blank; });
  var columns = ["opened", "met", "missed", "open_now", "stale"];

  function row(label, subset) {
    var c = summaryCounts(subset, startMin, nowMin);
    return [label].concat(columns.map(function (key) { return c[key]; }));
  }

  var table = [
    [t(lang, "summary.title", { start: fromMinutes(startMin), end: now })],
    [t(lang, "summary.group")].concat(columns.map(function (key) { return t(lang, "summary." + key); })),
  ];
  CATEGORIES.forEach(function (category) {
    table.push(row(t(lang, "category." + category),
      real.filter(function (tk) { return tk.category === category; })));
  });
  LANGUAGES.forEach(function (language) {
    table.push(row(t(lang, "language." + language),
      real.filter(function (tk) { return tk.language === language; })));
  });
  table.push(row(t(lang, "summary.total"), real));
  return table;
}

// ===== src/tracker.js =====
// Read the Tickets and Agents tabs (as plain 2D arrays) and check every ticket:
// priority floor, SLA due and status, stale follow-ups, who to alert today.
// The same functions run in Apps Script and in the Node demo and tests.

// Header names accepted for each column: English, Spanish, the id itself
// and the extra names from config.js, all folded (no accents, lowercase).
function columnAliases(key, extra) {
  var names = [key, STRINGS.en["header." + key], STRINGS.es["header." + key]]
    .concat((extra && extra[key]) || []);
  return names.map(foldText);
}

// headerRow -> { key: columnIndex }. Throws a clear error naming the missing
// columns in the sheet's language, so the user knows what to add.
function mapColumns(headerRow, keys, extra, required, lang) {
  var folded = headerRow.map(foldText);
  var map = {};
  keys.forEach(function (key) {
    var aliases = columnAliases(key, extra);
    for (var i = 0; i < folded.length; i++) {
      if (aliases.indexOf(folded[i]) !== -1) { map[key] = i; return; }
    }
  });
  var missing = (required || []).filter(function (key) { return !(key in map); });
  if (missing.length) {
    var names = missing.map(function (key) { return t(lang, "header." + key); });
    throw new Error(t(lang, "error.missing_columns", { columns: names.join(", ") }));
  }
  return map;
}

// "es" when most known headers are the Spanish ones, else "en". New values
// (priority, SLA status) are written in the language the sheet already uses.
function sheetLanguage(headerRow) {
  var en = 0, es = 0;
  headerRow.map(foldText).forEach(function (h) {
    TICKET_COLUMNS.forEach(function (key) {
      if (h === foldText(STRINGS.en["header." + key])) en++;
      if (h === foldText(STRINGS.es["header." + key])) es++;
    });
  });
  return es > en ? "es" : "en";
}

// Add any missing columns at the end of the header row, with headers in `lang`.
// Returns { header: new header row, map: { key: columnIndex } }.
function ensureColumns(headerRow, keys, lang) {
  var header = headerRow.slice();
  var map = mapColumns(header, TICKET_COLUMNS, EXTRA_COLUMN_ALIASES, [], lang);
  keys.forEach(function (key) {
    if (!(key in map)) {
      map[key] = header.length;
      header.push(t(lang, "header." + key));
    }
  });
  return { header: header, map: map };
}

function cell(row, map, key) {
  if (!(key in map)) return "";
  var value = row[map[key]];
  return value == null ? "" : String(value).trim();
}

// Agents tab -> [{ name, email, language, role }]. Rows without a valid email
// are skipped: a digest needs somewhere to go.
function readAgents(table, lang) {
  if (!table.length) return [];
  var map = mapColumns(table[0], AGENT_COLUMNS, EXTRA_AGENT_ALIASES, ["name", "email"], lang);
  var agents = [];
  table.slice(1).forEach(function (row) {
    var email = cell(row, map, "email");
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;
    agents.push({
      name: cell(row, map, "name"),
      email: email,
      language: idFromLabel("language", cell(row, map, "language"), ["en", "es"]) || "en",
      role: idFromLabel("role", cell(row, map, "role"), ["agent", "lead"]) || "agent",
    });
  });
  return agents;
}

// The agent behind an Assignee cell (by name or email), or null.
function findAgent(assignee, agents) {
  var folded = foldText(assignee);
  if (!folded) return null;
  for (var i = 0; i < agents.length; i++) {
    if (foldText(agents[i].name) === folded || foldText(agents[i].email) === folded) return agents[i];
  }
  return null;
}

function priorityRank(priority) {
  return PRIORITIES.indexOf(priority);
}

// Priority after the category floor. An empty or unknown Priority cell uses
// the category default. raisedFrom is set only when a typed priority was
// below the floor (for example a lost card marked "Low").
function effectivePriority(category, priorityCell) {
  var typed = idFromLabel("priority", priorityCell, PRIORITIES);
  var priority = typed || CATEGORY_DEFAULT_PRIORITY[category] || FALLBACK_PRIORITY;
  var floor = CATEGORY_PRIORITY_FLOOR[category];
  if (floor && priorityRank(priority) < priorityRank(floor)) {
    return { priority: floor, raisedFrom: priority };
  }
  return { priority: priority, raisedFrom: "" };
}

// "Waiting on customer" with no update for more than 2 business days.
function isStaleFollowUp(status, lastUpdateAt, now) {
  if (status !== "waiting") return false;
  var since = toMinutes(lastUpdateAt);
  if (since === null) return false;
  return businessMinutesBetween(since, toMinutes(now)) >
    FOLLOW_UP_BUSINESS_DAYS * BUSINESS_DAY_MINUTES;
}

// Check one data row. `now` is "YYYY-MM-DD HH:mm" in the team time zone.
function checkTicket(row, map, agents, now) {
  var category = idFromLabel("category", cell(row, map, "category"), CATEGORIES);
  var status = idFromLabel("status", cell(row, map, "status"), TICKET_STATUSES) || "open";
  var p = effectivePriority(category, cell(row, map, "priority"));
  var createdAt = cell(row, map, "created_at");
  var firstResponseAt = cell(row, map, "first_response_at");
  var lastUpdateAt = cell(row, map, "last_update_at");
  var subject = cell(row, map, "subject");
  var typedLanguage = idFromLabel("language", cell(row, map, "language"), LANGUAGES);
  var masked = maskSensitive(subject);

  // Resolving a ticket counts as its first response when none was logged.
  var answeredAt = firstResponseAt || (status === "resolved" ? lastUpdateAt : "");
  var sla = status === "resolved" && !answeredAt
    ? ""
    : slaStatus(createdAt, answeredAt, now, p.priority);

  var owner = findAgent(cell(row, map, "assignee"), agents);
  var open = status !== "resolved";
  // A name that is not on the Agents tab cannot receive a digest, so the
  // ticket counts as unowned.
  var unassignedUrgent = open && !owner && p.priority === "urgent";
  var stale = open && isStaleFollowUp(status, lastUpdateAt || firstResponseAt || createdAt, now);
  var lastAlerted = cell(row, map, "last_alerted");
  var alertedToday = lastAlerted.slice(0, 10) === String(now).slice(0, 10);
  // An open ticket whose dates can't be read has no SLA: the lead must fix it.
  var needsAttention = open && (sla === "breached" || sla === "at_risk" || sla === "bad_date" || stale);

  return {
    id: cell(row, map, "ticket_id"),
    createdAt: createdAt,
    customerId: cell(row, map, "customer_id"),
    subject: masked.text, // only the masked subject is kept
    maskedCount: masked.count,
    category: category,
    categoryText: cell(row, map, "category"),
    priority: p.priority,
    raisedFrom: p.raisedFrom,
    status: status,
    assignee: cell(row, map, "assignee"),
    owner: owner,
    language: typedLanguage || detectLanguage(subject),
    languageDetected: !typedLanguage,
    firstResponseAt: firstResponseAt,
    slaDue: slaDue(createdAt, p.priority),
    sla: sla,
    stale: stale,
    unassignedUrgent: unassignedUrgent,
    alertedToday: alertedToday,
    // Same-day repeats are skipped, except unassigned urgent tickets: those
    // are alerted on every run until someone owns them.
    alert: unassignedUrgent || (needsAttention && !alertedToday),
  };
}

// Tickets tab (header row + data rows) -> checked tickets, one per data row.
function checkTickets(table, agents, now, lang) {
  if (!table.length) return [];
  var map = mapColumns(table[0], TICKET_COLUMNS, EXTRA_COLUMN_ALIASES, REQUIRED_TICKET_COLUMNS, lang);
  // Empty rows stay in the list (marked blank) so results line up with sheet rows.
  // `row` is the data-row position (0 = first row under the header), used to
  // stamp Last alerted on exactly the rows that went out in a digest.
  return table.slice(1).map(function (row, i) {
    var blank = !row.some(function (v) { return String(v == null ? "" : v).trim(); });
    var ticket = blank ? { blank: true, alert: false } : checkTicket(row, map, agents, now);
    ticket.row = i;
    return ticket;
  });
}

// Order for people: unassigned urgent, breached, at risk, stale, the rest;
// then by due time.
function attentionRank(ticket) {
  if (ticket.unassignedUrgent) return 0;
  if (ticket.sla === "breached") return 1;
  if (ticket.sla === "at_risk") return 2;
  if (ticket.stale) return 3;
  return 4;
}

function sortForAttention(tickets) {
  return tickets.slice().sort(function (a, b) {
    return attentionRank(a) - attentionRank(b) || (a.slaDue < b.slaDue ? -1 : a.slaDue > b.slaDue ? 1 : 0);
  });
}

// Values the tracker writes back, one array per column, in data-row order.
// Priority is always written (floor applied), Language only when it was empty.
// alertedRows: data-row positions that were in a digest actually sent (see
// alertedRows() in digest.js); those get Last alerted = now. [] keeps it as is.
function columnUpdates(tickets, table, now, lang, alertedRows) {
  var map = mapColumns(table[0], TICKET_COLUMNS, EXTRA_COLUMN_ALIASES, [], lang);
  var rows = table.slice(1);
  // Blank rows get blank values, so nothing is written into empty lines.
  function column(fn) {
    return tickets.map(function (tk, i) { return tk.blank ? "" : fn(tk, rows[i]); });
  }
  return {
    priority: column(function (tk) { return t(lang, "priority." + tk.priority); }),
    language: column(function (tk, row) {
      return tk.languageDetected ? t(lang, "language." + tk.language) : cell(row, map, "language");
    }),
    sla_due: column(function (tk) { return tk.slaDue; }),
    sla_status: column(function (tk) { return tk.sla ? t(lang, "sla." + tk.sla) : ""; }),
    last_alerted: column(function (tk, row) {
      return (alertedRows || []).indexOf(tk.row) !== -1 ? now : cell(row, map, "last_alerted");
    }),
  };
}

// The whole table with columnUpdates applied (used by the Node demo to write
// output/tracker_checked.csv). Missing columns are added at the end.
function applyColumnUpdates(table, updates, lang) {
  var cols = ensureColumns(table[0], Object.keys(updates), lang);
  var out = [cols.header];
  table.slice(1).forEach(function (row, i) {
    var copy = row.slice();
    while (copy.length < cols.header.length) copy.push("");
    Object.keys(updates).forEach(function (key) { copy[cols.map[key]] = updates[key][i]; });
    out.push(copy);
  });
  return out;
}

// ===== apps-script/Code.gs =====
// ---------------------------------------------------------------------------
// Apps Script layer: the only part that touches Google Sheets, Gmail and
// triggers. All the rules (SLA math, priority floors, digests, summary) are
// the plain functions from src/ above, tested locally with `npm test`.
// This layer is kept thin on purpose. It has no automated tests; it was run
// once by hand in a real Google Sheet (see "Real Sheet test" in the README).
// ---------------------------------------------------------------------------

// DRY_RUN = true: digests are written to the "Digest preview" tab and nothing
// is emailed. Set it to false only after the preview looks right.
var DRY_RUN = true;

// Language for new tabs, headers, dropdowns and the menu: "en" or "es".
// Once the Tickets tab exists, its header row decides the language instead.
var SETUP_LANGUAGE = "en";

// --- Menu ------------------------------------------------------------------

function onOpen() {
  var lang = currentLanguage_();
  SpreadsheetApp.getUi().createMenu(t(lang, "menu.title"))
    .addItem(t(lang, "menu.check"), "checkSlas")
    .addItem(t(lang, "menu.send"), "sendDigests")
    .addSeparator()
    .addItem(t(lang, "menu.trigger"), "installDailyTrigger")
    .addToUi();
}

// --- Setup -----------------------------------------------------------------

// Creates the tabs, headers, dropdowns and colors. Safe to run again:
// existing tabs and rows are kept.
function setupTracker() {
  var lang = currentLanguage_();
  var ss = SpreadsheetApp.getActive();
  var tickets = findTab_("tickets") || ss.insertSheet(t(lang, "tab.tickets"));
  if (!String(tickets.getRange(1, 1).getValue()).trim()) {
    var header = TICKET_COLUMNS.map(function (key) { return t(lang, "header." + key); });
    tickets.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight("bold");
    tickets.setFrozenRows(1);
  }
  var map = mapColumns(tickets.getRange(1, 1, 1, tickets.getLastColumn()).getValues()[0],
    TICKET_COLUMNS, EXTRA_COLUMN_ALIASES, REQUIRED_TICKET_COLUMNS, lang);
  addDropdown_(tickets, map.category, labelsFor_("category", CATEGORIES, lang));
  addDropdown_(tickets, map.priority, labelsFor_("priority", PRIORITIES, lang));
  addDropdown_(tickets, map.status, labelsFor_("status", TICKET_STATUSES, lang));
  if ("language" in map) addDropdown_(tickets, map.language, labelsFor_("language", LANGUAGES, lang));
  if ("sla_status" in map) addSlaColors_(tickets, map.sla_status);

  var agents = findTab_("agents") || ss.insertSheet(t(lang, "tab.agents"));
  if (!String(agents.getRange(1, 1).getValue()).trim()) {
    var agentHeader = AGENT_COLUMNS.map(function (key) { return t(lang, "header." + key); });
    agents.getRange(1, 1, 1, agentHeader.length).setValues([agentHeader]).setFontWeight("bold");
    agents.setFrozenRows(1);
    addDropdown_(agents, 2, labelsFor_("language", ["en", "es"], lang));
    addDropdown_(agents, 3, labelsFor_("role", ["agent", "lead"], lang));
  }
  if (!findTab_("preview")) ss.insertSheet(t(lang, "tab.preview"));
  if (!findTab_("summary")) ss.insertSheet(t(lang, "tab.summary"));
  notify_(t(lang, "done.setup", { tab: agents.getName() }));
}

function labelsFor_(kind, ids, lang) {
  return ids.map(function (id) { return t(lang, kind + "." + id); });
}

// Every data row of one column (0-based index), down to the sheet's last row.
function dataColumn_(sheet, columnIndex) {
  return sheet.getRange(2, columnIndex + 1, Math.max(sheet.getMaxRows() - 1, 1), 1);
}

// Dropdown on one column. Other values only show a warning, so rows pasted
// with the other language's labels still work.
function addDropdown_(sheet, columnIndex, labels) {
  var rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(labels, true).setAllowInvalid(true).build();
  dataColumn_(sheet, columnIndex).setDataValidation(rule);
}

// Red for Breached / Missed, yellow for At risk, in both languages.
// Added to the tab's existing rules: the client's own colors are kept, and
// our rules from an earlier setup are replaced instead of duplicated.
function addSlaColors_(sheet, columnIndex) {
  var range = dataColumn_(sheet, columnIndex);
  var colors = { breached: "#f4c7c3", missed: "#f4c7c3", at_risk: "#fce8b2" };
  var ours = [];
  var rules = [];
  Object.keys(colors).forEach(function (status) {
    ["en", "es"].forEach(function (lang) {
      ours.push(t(lang, "sla." + status));
      rules.push(SpreadsheetApp.newConditionalFormatRule()
        .whenTextEqualTo(t(lang, "sla." + status)).setBackground(colors[status])
        .setRanges([range]).build());
    });
  });
  var kept = sheet.getConditionalFormatRules().filter(function (rule) {
    var condition = rule.getBooleanCondition();
    return !(condition &&
      condition.getCriteriaType() === SpreadsheetApp.BooleanCriteria.TEXT_EQUAL_TO &&
      ours.indexOf(String(condition.getCriteriaValues()[0])) !== -1);
  });
  sheet.setConditionalFormatRules(kept.concat(rules));
}

// --- Check and send --------------------------------------------------------

// Fills Priority (category floor), Language (when empty), SLA due, SLA status,
// and rewrites the Weekly summary tab. Sends nothing.
function checkSlas() {
  var state = loadTracker_();
  writeColumns_(state, []);
  writeSummary_(state);
  notify_(tCount(state.lang, "done.check", state.tickets.filter(function (tk) { return !tk.blank; }).length));
  return state;
}

// Checks SLAs, then builds the digests. DRY_RUN: preview tab only.
// Recipients come only from the Agents tab (see buildDigests in src/digest.js).
function sendDigests() {
  var state = checkSlas();
  if (!state.agents.length) throw new Error(t(state.lang, "error.no_agents"));
  // No lead on the Agents tab: unassigned tickets would reach nobody. Stop
  // with a clear message instead of saying "Nothing to report".
  var noLead = missingLeadError(state.tickets, state.agents, state.lang);
  if (noLead) throw new Error(noLead);
  var digests = buildDigests(state.tickets, state.agents, state.now);
  if (!digests.length) {
    notify_(t(state.lang, "done.nothing"));
    return;
  }
  if (DRY_RUN) {
    var tab = findTab_("preview") || SpreadsheetApp.getActive().insertSheet(t(state.lang, "tab.preview"));
    var rows = [[t(state.lang, "preview.to"), t(state.lang, "header.subject"), t(state.lang, "preview.body")]];
    digests.forEach(function (d) { rows.push([d.to, d.subject, d.text]); });
    tab.clearContents();
    tab.getRange(1, 1, rows.length, 3).setValues(rows);
    // Last alerted is NOT updated in DRY_RUN, so you can preview again today.
    notify_(tCount(state.lang, "done.preview", digests.length, { tab: tab.getName() }));
    return;
  }
  // Daily email limits apply (MailApp quotas). See Google's quota page:
  // https://developers.google.com/apps-script/guides/services/quotas
  digests.forEach(function (d) {
    MailApp.sendEmail({ to: d.to, subject: d.subject, body: d.text, htmlBody: d.html });
  });
  // Stamp Last alerted only on tickets in the digests just sent: no same-day repeats.
  writeColumns_(state, alertedRows(digests));
  notify_(tCount(state.lang, "done.sent", digests.length));
}

// One trigger that runs sendDigests every day around 07:30 in the
// spreadsheet's time zone (Apps Script picks a minute within about 15 minutes of :30).
// Runs on weekends too: urgent tickets are on a 24/7 clock.
function installDailyTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (trigger.getHandlerFunction() === "sendDigests") ScriptApp.deleteTrigger(trigger);
  });
  ScriptApp.newTrigger("sendDigests").timeBased().everyDays(1).atHour(7).nearMinute(30)
    .inTimezone(teamTimeZone_()).create();
  notify_(t(currentLanguage_(), "done.trigger"));
}

// --- Sheet helpers ---------------------------------------------------------

// The team time zone is the spreadsheet's (File > Settings), so business
// hours and "same day" dedupe follow the sheet, whoever owns the script.
function teamTimeZone_() {
  return SpreadsheetApp.getActive().getSpreadsheetTimeZone();
}

// A tab by its English or Spanish name, or null.
function findTab_(key) {
  var ss = SpreadsheetApp.getActive();
  return ss.getSheetByName(t("en", "tab." + key)) || ss.getSheetByName(t("es", "tab." + key));
}

function currentLanguage_() {
  var tickets = findTab_("tickets");
  if (!tickets || tickets.getLastColumn() === 0) return SETUP_LANGUAGE;
  return sheetLanguage(tickets.getRange(1, 1, 1, tickets.getLastColumn()).getValues()[0]);
}

// All values of a tab as text. Date cells become "YYYY-MM-DD HH:mm" in the
// spreadsheet time zone, which is the format the src/ functions expect.
function readTable_(sheet) {
  var tz = teamTimeZone_();
  return sheet.getDataRange().getValues().map(function (row) {
    return row.map(function (value) {
      return value instanceof Date ? Utilities.formatDate(value, tz, "yyyy-MM-dd HH:mm") : value;
    });
  });
}

function loadTracker_() {
  var sheet = findTab_("tickets");
  if (!sheet) throw new Error(t(SETUP_LANGUAGE, "error.no_tickets_tab", { tab: t(SETUP_LANGUAGE, "tab.tickets") }));
  var table = readTable_(sheet);
  var lang = sheetLanguage(table[0] || []);
  var agentsTab = findTab_("agents");
  var agents = agentsTab ? readAgents(readTable_(agentsTab), lang) : [];
  var now = Utilities.formatDate(new Date(), teamTimeZone_(), "yyyy-MM-dd HH:mm");
  return {
    sheet: sheet, table: table, lang: lang, agents: agents, now: now,
    tickets: checkTickets(table, agents, now, lang),
  };
}

// Write the tracker's columns back, one column at a time, so the columns
// people type in (subject, assignee, dates) are never overwritten.
// rowsToStamp: data rows that get Last alerted = now ([] leaves it alone).
function writeColumns_(state, rowsToStamp) {
  if (state.table.length < 2) return;
  var updates = columnUpdates(state.tickets, state.table, state.now, state.lang, rowsToStamp);
  if (!rowsToStamp.length) delete updates.last_alerted;
  var cols = ensureColumns(state.table[0], Object.keys(updates), state.lang);
  if (cols.header.length > state.table[0].length) {
    var missing = cols.header.length - state.sheet.getMaxColumns();
    if (missing > 0) state.sheet.insertColumnsAfter(state.sheet.getMaxColumns(), missing);
    state.sheet.getRange(1, 1, 1, cols.header.length).setValues([cols.header]);
  }
  Object.keys(updates).forEach(function (key) {
    var values = updates[key].map(function (v) { return [v]; });
    state.sheet.getRange(2, cols.map[key] + 1, values.length, 1).setValues(values);
  });
}

function writeSummary_(state) {
  var tab = findTab_("summary") || SpreadsheetApp.getActive().insertSheet(t(state.lang, "tab.summary"));
  var table = weeklySummary(state.tickets, state.now, state.lang);
  var width = table[1].length;
  // setValues needs every row to have the same length.
  var rows = table.map(function (row) {
    var copy = row.slice();
    while (copy.length < width) copy.push("");
    return copy;
  });
  tab.clearContents();
  tab.getRange(1, 1, rows.length, width).setValues(rows);
}

// Message for the person at the sheet. Triggers have no UI, so it also goes
// to the execution log.
function notify_(message) {
  Logger.log(message);
  try {
    SpreadsheetApp.getActive().toast(message, t(currentLanguage_(), "menu.title"), 8);
  } catch (e) {
    // No spreadsheet UI (time-based trigger): the log line above is enough.
  }
}
